  "license": "MIT",
  "author": "lxj5820",
  "contributors": [
    {
      "name": "KEYloyee"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEYloyee/dsh-boot-animation-pro.git"
  },
  "homepage": "https://github.com/KEYloyee/dsh-boot-animation-pro#readme",
  "bugs": {
    "url": "https://github.com/KEYloyee/dsh-boot-animation-pro/issues"
  },
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
